{
  "name": "siscon-ceciamb",
  "version": "0.0.1",
  "private": true,
  "description": "Sistema contable SISCON-CECIAMB (inspirado en CIACLI Contabilidad Sparrow)",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "lint": "oxlint server/src server/tests client/src",
    "format": "prettier --write .",
    "test": "npm test -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:rollback": "npm run db:rollback -w server",
    "db:seed": "npm run db:seed -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9"
  }
}
