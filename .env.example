# Servidor
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Base de datos (MariaDB local, compatible MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=siscon_app
DB_PASSWORD=
DB_NAME=siscon_db

# Credencial administrativa local (no usar en la app)
DB_ROOT_PASSWORD=

# Autenticación
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Usuario administrador inicial (lo crea el seed)
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@ceciamb.local
ADMIN_PASSWORD=

# Horas (Caracas, 24 h) de la actualización automática de la tasa BCV
BCV_HORAS=09:00,17:00

# Producción: solo true si el sistema se publica con https
COOKIE_SECURE=false

# Bot de despliegue (copia de producción en la rama main)
BOT_RAMA=main
BOT_INTERVALO_MIN=5
BOT_PRUEBAS=true
BOT_RESPALDOS=respaldos
MARIADB_DUMP=C:/Program Files/MariaDB 13.0/bin/mariadb-dump.exe
